    {
      "id": "action-button/tones",
      "title": "Playground",
      "component": "ActionButton",
      "description": "Every prop as a knob.",
      "source": "let tone = knobs.select(\"tone\", &[\"primary\", \"neutral\", \"danger\"], \"primary\");\nlet tone = Tone::ALL\n    .iter()\n    .find(|(name, _)| *name == tone)\n    .map_or(Tone::Primary, |(_, tone)| *tone);\nlet size = match knobs.select(\"size\", &[\"small\", \"medium\", \"large\"], \"medium\") {\n    \"small\" => Size::Small,\n    \"large\" => Size::Large,\n    _ => Size::Medium,\n};\nActionButton::new(\n    \"action\",\n    knobs.text_samples(\"label\", &[\"Save changes\", \"Delete\"]),\n)\n.tone(tone)\n.size(size)\n.disabled(knobs.bool(\"disabled\", false))\n.loading(knobs.bool(\"loading\", false))",
      "knobs": [
        {
          "name": "tone",
          "type": "select",
          "options": [
            "primary",
            "neutral",
            "danger"
          ],
          "default": "primary"
        },
        {
          "name": "size",
          "type": "select",
          "options": [
            "small",
            "medium",
            "large"
          ],
          "default": "medium"
        },
        {
          "name": "label",
          "type": "text",
          "samples": [
            "Save changes",
            "Delete"
          ],
          "default": "Save changes"
        },
        {
          "name": "disabled",
          "type": "bool",
          "default": false
        },
        {
          "name": "loading",
          "type": "bool",
          "default": false
        }
      ],
      "themes": [
        "light",
        "dark"
      ],
      "variants": [
